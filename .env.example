# 배포 시 이 파일을 복사: cp .env.example .env 후 값 수정
# Jetson:  docker compose --env-file .env up --build -d
# x86 등:  docker compose -f docker-compose.cpu.yml --env-file .env up --build -d

# ── 포트 (호스트에서 열리는 포트) ─────────────────────────────────────────────
ORCHESTRATOR_PORT=8000
CAMERA_PORT=8001

# ── Muse2 (EEG 컨테이너) ─────────────────────────────────────────────────────
EEG_MODE=muse2
# bluetoothctl → scan on 후 Muse MAC (필수)
MUSE_ADDRESS=00:55:DA:XX:XX:XX

# 학습 모델: 호스트 ./models 에 두고 컨테이너 /models 로 마운트 (권장)
MODELS_DIR=./models
MUSE_MODEL_PATH=/models/MUSE_activity_model.keras

# ── 졸음 단계 threshold (orchestrator) ───────────────────────────────────────
FUSION_THRESHOLD_CAUTION=0.32
FUSION_THRESHOLD_WARNING=0.52
FUSION_THRESHOLD_DROWSY=0.72

# ── AI baseline (eeg) ────────────────────────────────────────────────────────
EEG_MODEL_AWAKE_BASELINE=0.50
EEG_MODEL_BASELINE_CALIB_SEC=30

# ── 카메라 (선택) ────────────────────────────────────────────────────────────
CAM_FPS=15

# EEG 없이 카메라만 테스트: EEG_MODE=stub (eeg 컨테이너는 그대로 두거나 compose에서 제외)
